generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  VENDEDOR
  CAJERO
}

enum MovementType {
  ENTRADA
  SALIDA
  AJUSTE
  DEVOLUCION
}

enum SaleStatus {
  ACTIVE
  VOID
}

enum DocType {
  DNI
  RUC
  CE
  PASSPORT
  NONE
}

enum CashRegisterStatus {
  OPEN
  CLOSED
}

enum CashMovementType {
  INGRESO
  EGRESO
  RETIRO
}

enum PurchaseStatus {
  PENDIENTE
  RECIBIDA
  CANCELADA
}

model Business {
  id                 String   @id @default(cuid())
  name               String
  legalName          String?
  ruc                String?
  address            String?
  phone              String?
  whatsapp           String?
  email              String?
  logoUrl            String?
  currency           String   @default("PEN")
  currencySymbol     String   @default("S/")
  igvEnabled         Boolean  @default(true)
  igvPercent         Decimal  @default(18.00) @db.Decimal(5, 2)
  igvIncluded        Boolean  @default(true)
  ticketSeries       String   @default("B001")
  allowNegativeStock Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  users              User[]
  categories         Category[]
  brands             Brand[]
  products           Product[]
  customers          Customer[]
  paymentMethods     PaymentMethod[]
  sales              Sale[]
  inventoryMovements InventoryMovement[]
  auditLogs          AuditLog[]
  ticketCounter      TicketCounter?
  cashRegisters      CashRegister[]
  cashMovements      CashMovement[]
  returns            Return[]
  suppliers          Supplier[]
  purchases          Purchase[]

  @@map("businesses")
}

model TicketCounter {
  id         String   @id @default(cuid())
  businessId String   @unique
  business   Business @relation(fields: [businessId], references: [id])
  series     String
  current    Int      @default(0)
  updatedAt  DateTime @updatedAt

  @@map("ticket_counters")
}

model User {
  id           String    @id @default(cuid())
  businessId   String
  business     Business  @relation(fields: [businessId], references: [id])
  name         String
  email        String    @unique
  passwordHash String
  role         Role      @default(VENDEDOR)
  active       Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  sales               Sale[]               @relation("SaleUser")
  voidedSales         Sale[]               @relation("SaleVoidedBy")
  inventoryMovements  InventoryMovement[]
  auditLogs           AuditLog[]
  cashRegistersOpened CashRegister[]       @relation("CashRegisterOpenedBy")
  cashRegistersClosed CashRegister[]       @relation("CashRegisterClosedBy")
  cashMovements       CashMovement[]
  returns             Return[]
  purchasesCreated    Purchase[]           @relation("PurchaseCreatedBy")
  purchasesReceived   Purchase[]           @relation("PurchaseReceivedBy")

  @@index([businessId])
  @@map("users")
}

model Category {
  id         String     @id @default(cuid())
  businessId String
  business   Business   @relation(fields: [businessId], references: [id])
  name       String
  parentId   String?
  parent     Category?  @relation("CategoryToSub", fields: [parentId], references: [id])
  children   Category[] @relation("CategoryToSub")
  active     Boolean    @default(true)
  createdAt  DateTime   @default(now())

  products Product[]

  @@index([businessId])
  @@map("categories")
}

model Brand {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id])
  name       String
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())

  products Product[]

  @@index([businessId])
  @@map("brands")
}

model Product {
  id            String    @id @default(cuid())
  businessId    String
  business      Business  @relation(fields: [businessId], references: [id])
  sku           String?
  barcode       String?
  name          String
  description   String?
  categoryId    String?
  category      Category? @relation(fields: [categoryId], references: [id])
  brandId       String?
  brand         Brand?    @relation(fields: [brandId], references: [id])
  // Data URL (base64, comprimida en el cliente) o una URL externa — mismo
  // criterio sin-storage-externo que el QR de PaymentMethod.
  imageUrl      String?   @db.Text
  purchasePrice Decimal   @db.Decimal(10, 2)
  salePrice     Decimal   @db.Decimal(10, 2)
  stock         Int       @default(0)
  minStock      Int       @default(0)
  unit          String    @default("unidad")
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  saleItems          SaleItem[]
  inventoryMovements InventoryMovement[]
  returnItems        ReturnItem[]
  purchaseItems      PurchaseItem[]

  @@unique([businessId, barcode])
  @@unique([businessId, sku])
  @@index([businessId, name])
  @@map("products")
}

model Customer {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id])
  name       String
  docType    DocType  @default(NONE)
  docNumber  String?
  phone      String?
  address    String?
  email      String?
  isGeneral  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  sales Sale[]

  @@unique([businessId, docNumber])
  @@index([businessId, name])
  @@map("customers")
}

model PaymentMethod {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id])
  name       String
  code       String
  active     Boolean  @default(true)
  sortOrder  Int      @default(0)
  // QR para pagos por Yape/Plin/etc. — se guarda como data URL (base64) en vez
  // de subirlo a un storage externo, mismo criterio que las imágenes de
  // producto: sin credenciales de nube configuradas en este proyecto. Cabe
  // perfectamente en un TEXT de Postgres para una imagen de este tamaño.
  qrImageUrl String?  @db.Text

  payments Payment[]

  @@unique([businessId, code])
  @@map("payment_methods")
}

model Sale {
  id             String     @id @default(cuid())
  businessId     String
  business       Business   @relation(fields: [businessId], references: [id])
  ticketSeries   String
  ticketNumber   Int
  customerId     String
  customer       Customer   @relation(fields: [customerId], references: [id])
  userId         String
  user           User       @relation("SaleUser", fields: [userId], references: [id])
  subtotal       Decimal    @db.Decimal(10, 2)
  discount       Decimal    @default(0) @db.Decimal(10, 2)
  igvAmount      Decimal    @default(0) @db.Decimal(10, 2)
  total          Decimal    @db.Decimal(10, 2)
  amountReceived Decimal?   @db.Decimal(10, 2)
  changeAmount   Decimal?   @db.Decimal(10, 2)
  status         SaleStatus @default(ACTIVE)
  voidedAt       DateTime?
  voidedById     String?
  voidedBy       User?      @relation("SaleVoidedBy", fields: [voidedById], references: [id])
  voidReason     String?
  createdAt      DateTime   @default(now())

  items    SaleItem[]
  payments Payment[]
  returns  Return[]

  @@unique([businessId, ticketSeries, ticketNumber])
  @@index([businessId, createdAt])
  @@map("sales")
}

model SaleItem {
  id          String  @id @default(cuid())
  saleId      String
  sale        Sale    @relation(fields: [saleId], references: [id])
  productId   String
  product     Product @relation(fields: [productId], references: [id])
  productName String
  quantity    Int
  unitPrice   Decimal @db.Decimal(10, 2)
  unitCost    Decimal @db.Decimal(10, 2)
  discount    Decimal @default(0) @db.Decimal(10, 2)
  subtotal    Decimal @db.Decimal(10, 2)

  returnItems ReturnItem[]

  @@index([saleId])
  @@index([productId])
  @@map("sale_items")
}

model Payment {
  id              String        @id @default(cuid())
  saleId          String
  sale            Sale          @relation(fields: [saleId], references: [id])
  paymentMethodId String
  paymentMethod   PaymentMethod @relation(fields: [paymentMethodId], references: [id])
  amount          Decimal       @db.Decimal(10, 2)
  reference       String?

  @@map("payments")
}

model InventoryMovement {
  id            String       @id @default(cuid())
  businessId    String
  business      Business     @relation(fields: [businessId], references: [id])
  productId     String
  product       Product      @relation(fields: [productId], references: [id])
  type          MovementType
  quantity      Int
  previousStock Int
  newStock      Int
  reason        String?
  referenceType String?
  referenceId   String?
  userId        String
  user          User         @relation(fields: [userId], references: [id])
  createdAt     DateTime     @default(now())

  @@index([businessId, productId, createdAt])
  @@map("inventory_movements")
}

model AuditLog {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id])
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([businessId, createdAt])
  @@map("audit_logs")
}

model CashRegister {
  id             String             @id @default(cuid())
  businessId     String
  business       Business           @relation(fields: [businessId], references: [id])
  openedById     String
  openedBy       User               @relation("CashRegisterOpenedBy", fields: [openedById], references: [id])
  closedById     String?
  closedBy       User?              @relation("CashRegisterClosedBy", fields: [closedById], references: [id])
  openingAmount  Decimal            @db.Decimal(10, 2)
  openedAt       DateTime           @default(now())
  closedAt       DateTime?
  countedAmount  Decimal?           @db.Decimal(10, 2)
  expectedAmount Decimal?           @db.Decimal(10, 2)
  difference     Decimal?           @db.Decimal(10, 2)
  status         CashRegisterStatus @default(OPEN)
  notes          String?

  movements CashMovement[]

  @@index([businessId, status])
  @@map("cash_registers")
}

model CashMovement {
  id             String           @id @default(cuid())
  businessId     String
  business       Business         @relation(fields: [businessId], references: [id])
  cashRegisterId String
  cashRegister   CashRegister     @relation(fields: [cashRegisterId], references: [id])
  type           CashMovementType
  amount         Decimal          @db.Decimal(10, 2)
  reason         String
  userId         String
  user           User             @relation(fields: [userId], references: [id])
  createdAt      DateTime         @default(now())

  @@index([businessId, cashRegisterId])
  @@map("cash_movements")
}

model Return {
  id          String   @id @default(cuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id])
  saleId      String
  sale        Sale     @relation(fields: [saleId], references: [id])
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  reason      String
  totalAmount Decimal  @db.Decimal(10, 2)
  createdAt   DateTime @default(now())

  items ReturnItem[]

  @@index([businessId, saleId])
  @@index([businessId, createdAt])
  @@map("returns")
}

model ReturnItem {
  id         String   @id @default(cuid())
  returnId   String
  return     Return   @relation(fields: [returnId], references: [id])
  saleItemId String
  saleItem   SaleItem @relation(fields: [saleItemId], references: [id])
  productId  String
  product    Product  @relation(fields: [productId], references: [id])
  quantity   Int
  unitPrice  Decimal  @db.Decimal(10, 2)
  subtotal   Decimal  @db.Decimal(10, 2)

  @@index([returnId])
  @@index([saleItemId])
  @@map("return_items")
}

model Supplier {
  id          String   @id @default(cuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id])
  name        String
  ruc         String?
  contactName String?
  phone       String?
  email       String?
  address     String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  purchases Purchase[]

  @@unique([businessId, ruc])
  @@index([businessId, name])
  @@map("suppliers")
}

model Purchase {
  id            String         @id @default(cuid())
  businessId    String
  business      Business       @relation(fields: [businessId], references: [id])
  supplierId    String
  supplier      Supplier       @relation(fields: [supplierId], references: [id])
  userId        String
  user          User           @relation("PurchaseCreatedBy", fields: [userId], references: [id])
  status        PurchaseStatus @default(PENDIENTE)
  invoiceNumber String?
  total         Decimal        @db.Decimal(10, 2)
  notes         String?
  createdAt     DateTime       @default(now())
  receivedAt    DateTime?
  receivedById  String?
  receivedBy    User?          @relation("PurchaseReceivedBy", fields: [receivedById], references: [id])
  cancelledAt   DateTime?
  cancelReason  String?

  items PurchaseItem[]

  @@index([businessId, status])
  @@index([businessId, createdAt])
  @@map("purchases")
}

model PurchaseItem {
  id         String   @id @default(cuid())
  purchaseId String
  purchase   Purchase @relation(fields: [purchaseId], references: [id])
  productId  String
  product    Product  @relation(fields: [productId], references: [id])
  quantity   Int
  unitCost   Decimal  @db.Decimal(10, 2)
  subtotal   Decimal  @db.Decimal(10, 2)

  @@index([purchaseId])
  @@map("purchase_items")
}
