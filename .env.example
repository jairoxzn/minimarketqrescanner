DATABASE_URL="postgresql://user:password@host-pooler/db?sslmode=verify-full"
DATABASE_URL_UNPOOLED="postgresql://user:password@host/db?sslmode=verify-full"
# sslmode=verify-full (not "require") to avoid pg-connection-string's deprecation
# warning about 'require' being loosely treated as an alias for verify-full today.

NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"

NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional: SMTP for password-reset emails. If unset, reset links are logged to the server console.
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM="VendeMóvil <no-reply@vendemovil.com>"
